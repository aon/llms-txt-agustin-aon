  "elements": [
    {
      "id": "JdQ2gsGPX7bXdGcJSDBOZ",
      "type": "text",
      "x": 4463.821725777803,
      "y": 1729.5304233601923,
      "width": 937.8875732421875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 1590526452,
      "version": 142,
      "versionNonce": 1509746664,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789398901954,
      "created": 1789066311791,
      "link": null,
      "locked": false,
      "text": "GOAL\nChat analytics platform that handles millones of conversations daily.\nWe want to be able to produce insights from this conversations.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GOAL\nChat analytics platform that handles millones of conversations daily.\nWe want to be able to produce insights from this conversations.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "f7R524vFmru6rlyH1DETy",
      "type": "text",
      "x": 4473.159160112296,
      "y": 1886.6254611674642,
      "width": 708.427734375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 905585356,
      "version": 137,
      "versionNonce": 2123623064,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789398901954,
      "created": 1789066360758,
      "link": null,
      "locked": false,
      "text": "SCALE\n- 2M+ new conversations per day\n- Asymmetric: users responses are short, AI is large\n    - 1 year of conv history",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SCALE\n- 2M+ new conversations per day\n- Asymmetric: users responses are short, AI is large\n    - 1 year of conv history",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "doSfMuj9jHNhPmNuoS6Yb",
      "type": "text",
      "x": 4469.161571037842,
      "y": 2054.713868929486,
      "width": 365.4278564453125,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 1070210932,
      "version": 122,
      "versionNonce": 1424468712,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789398901954,
      "created": 1789066409234,
      "link": null,
      "locked": false,
      "text": "SYSTEM REQUIREMENTS\n- Data processing\n- Clustering & analysis\n- Query & access",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SYSTEM REQUIREMENTS\n- Data processing\n- Clustering & analysis\n- Query & access",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "4Fivfe351ZGDA9yqtbHhK",
      "type": "text",
      "x": 4456.958810744296,
      "y": 2489.668367998209,
      "width": 1119.2437744140625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 612387060,
      "version": 611,
      "versionNonce": 250271640,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789398901954,
      "created": 1789066646288,
      "link": null,
      "locked": false,
      "text": "NON-FUNCTIONAL REQUIREMENTS\n- System should be efficient, handle variable length messages\n- System should be fast to query conversations\n- System should be able to handle 25 msg/sec\n- System should be idempotent, we dont want to process twice the same message",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NON-FUNCTIONAL REQUIREMENTS\n- System should be efficient, handle variable length messages\n- System should be fast to query conversations\n- System should be able to handle 25 msg/sec\n- System should be idempotent, we dont want to process twice the same message",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "PwAtKZKC4rKb-Ll46fs7u",
      "type": "text",
      "x": 4459.20336250581,
      "y": 2237.609393640622,
      "width": 868.3636474609375,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aBV",
      "roundness": null,
      "seed": 1322641100,
      "version": 256,
      "versionNonce": 1266814440,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789398901954,
      "created": 1789066542553,
      "link": null,
      "locked": false,
      "text": "FUNCTIONAL REQUIREMENTS\n- Ingest conversations from a LLM and store them\nfor later processing\n- Analyze conversations and produce clustering, topic detection\nand pattern recognition\n- Query conversations",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FUNCTIONAL REQUIREMENTS\n- Ingest conversations from a LLM and store them\nfor later processing\n- Analyze conversations and produce clustering, topic detection\nand pattern recognition\n- Query conversations",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
