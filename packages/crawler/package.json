{
  "name": "@llms-txt/crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "crawl": "pnpm -w exec turbo run build --filter=@llms-txt/crawler && node scripts/crawl.ts"
  },
  "dependencies": {
    "@llms-txt/core": "workspace:*",
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
